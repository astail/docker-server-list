# cp .env.example .env して使う

# ---------------------------------------------------------------- 公開範囲
# 既定は 127.0.0.1（同じマシンからのみ）。このダッシュボードはコンテナ名・
# イメージ・ポート・compose ファイルのパスを認証なしで見せるので、広げるときは
# 下の AUTH_* をセットで検討すること。
#   127.0.0.1 … 同じマシンのみ（既定）
#   192.168.x.y … その NIC を持つ LAN のみ
#   0.0.0.0   … 全インタフェース（ルータのポート開放があると外部に漏れる）
LISTEN_ADDR=127.0.0.1

# ホスト側の公開ポート
HTTP_PORT=8080

# ---------------------------------------------------------------- 認証
# 両方セットしたときだけ HTTP Basic 認証が有効になる。
# 平文 HTTP なので、LAN の外に出すなら TLS 終端のリバースプロキシと併用すること。
# AUTH_USER=admin
# AUTH_PASSWORD=
# パスワード生成例: openssl rand -base64 24

# 自分で用意したリバースプロキシを前段に置く場合のみ 1 にする。
# 1 にすると認証失敗のロックアウトを X-Forwarded-For の最終ホップ単位で数えるため、
# 攻撃者 1 人が全利用者を巻き添えにする問題を避けられる。
# プロキシが無い状態で 1 にすると、ヘッダ詐称でロックアウトを回避されるので注意。
TRUST_PROXY=0

# ---------------------------------------------------------------- 収集
# Docker API を叩く間隔（ミリ秒）。コンテナ数が多いなら伸ばす
REFRESH_INTERVAL_MS=5000

# 最終収集からこの時間を過ぎたら /healthz を 503 にする（既定は収集間隔の 6 倍、最低 30 秒）
# HEALTH_MAX_AGE_MS=30000

# 公開ポートへの HTTP プローブ（「アクセス」タイルの判定に使う）。切るなら 0
HTTP_PROBE=1

# 同じポートを再プローブするまでの間隔（ミリ秒）
PROBE_TTL_MS=30000
